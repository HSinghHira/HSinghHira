---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import PageContainer from "@/components/PageContainer.astro";
import { getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import {
  Map,
  MapMarker,
  MarkerContent,
  MarkerPopup,
} from "@/components/ui/map";
import SocialLinksGrid from "@/components/SocialLinksGrid.astro";

const contactPage = await getEntry("pages", "contact");
let Content;
if (contactPage) {
  const rendered = await render(contactPage);
  Content = rendered.Content;
}
---

<Layout title="Contact | Harman Singh Hira" schemaType="contact">
  <PageContainer>
    <PageHeader
      comment="// ping_me.js"
      label="Contact"
      title="Let's talk <span>about anything.</span>"
      subtitle="Got an interesting idea, want to collaborate, or just want to say hi? Drop me a message below."
    />

    <div class="contact-layout reveal">
      <div class="contact-grid">
        <div class="contact-left">
          <div class="map-wrapper">
            <Map
              client:load
              viewport={{ center: [174.7633, -36.8485], zoom: 11 }}
              className="w-full h-full"
            >
              <MapMarker longitude={174.7633} latitude={-36.8485}>
                <MarkerContent />
                <MarkerPopup closeButton>
                  <div class="p-1">
                    <h3 class="font-bold text-sm">Auckland, NZ</h3>
                    <p class="text-muted-foreground text-xs">
                      The City of Sails ⛵
                    </p>
                  </div>
                </MarkerPopup>
              </MapMarker>
            </Map>
          </div>
        </div>

        <div class="contact-right">
          <div class="iframe-wrapper">
            <iframe
              src="https://msg.hsinghhira.me/"
              width="100%"
              height="415px"
              title="Contact Form"
              loading="lazy"></iframe>
          </div>
        </div>
      </div>
    </div>
    <SocialLinksGrid />
    <div
      class="social-links"
      style={{ marginBottom: "2rem", marginTop: "1rem" }}
    >
      <div class="social-link" style={{ cursor: "text" }}>
        <span class="social-icon"><Icon name="mdi:email-outline" /></span><span
          style={{ fontFamily: "var(--font-mono)" }}
          >echo "cG9wZS1zbW9raW5nLWNvbWVAZHVjay5jb20=" | base64 -d</span
        >
      </div>
    </div>
    <div class="article-body">
      {Content && <Content />}
    </div>
  </PageContainer>
</Layout>

<style>
  .contact-layout {
    margin-bottom: 0.5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .contact-grid {
      gap: 0.5rem;
    }
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  .map-wrapper {
    margin-bottom: 1.5rem;
    height: 400px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    background: var(--bg-2);
  }

  .social-section {
    padding: 0.5rem 0;
  }

  .section-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .section-title::before {
    content: "";
    width: 3px;
    height: 1rem;
    background: var(--accent);
    border-radius: 99px;
  }

  .iframe-wrapper {
    height: 400px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    background: var(--bg-2);
  }

  .iframe-wrapper iframe {
    border: none;
    display: block;
  }

  .contact-note {
    margin-top: 1rem;
    padding: 1rem;
    background: var(--accent-dim2);
    border: 1px solid var(--accent-dim);
    border-radius: 12px;
    font-size: 0.9rem;
    color: var(--text-2);
    text-align: center;
  }

  .article-body {
    max-width: 100%;

  }
  @media (max-width: 1024px) {
    .contact-layout {
      margin-bottom: 2rem;
    }
  }
</style>
