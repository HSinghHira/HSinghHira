---
import Layout from "@/layouts/Layout.astro";
import { getEntry, render } from "astro:content";
import { Map, MapMarker, MarkerContent, MarkerPopup } from "@/components/ui/map";

const contactPage = await getEntry("pages", "contact");
let Content;
if (contactPage) {
  const rendered = await render(contactPage);
  Content = rendered.Content;
}
---

<Layout title="Contact | Harman Singh Hira" schemaType="contact">
  <section style="padding-top:clamp(6rem,12vw,9rem); min-height:80vh;">
    <div class="container" style="max-width:800px; margin:0 auto;">
      <div class="section-header" style="margin-bottom:3rem;">
        <div class="code-comment">// ping_me.js</div>
        <div class="label">Contact</div>
        <h2 class="section-title">Let's Chat</h2>
        <p class="section-subtitle">Got an interesting idea, want to collaborate, or just want to say hi? Drop me a message below.</p>
      </div>

      <div style="margin-bottom:3rem; height: 350px; border-radius: 16px; overflow: hidden; border: 1px solid var(--border); box-shadow: var(--shadow);">
        <Map 
          client:load 
          viewport={{ center: [174.7633, -36.8485], zoom: 11 }} 
          className="h-full w-full"
        >
          <MapMarker longitude={174.7633} latitude={-36.8485}>
            <MarkerContent />
            <MarkerPopup closeButton>
              <div class="p-1">
                <h3 class="font-bold text-sm">Auckland, NZ</h3>
                <p class="text-xs text-muted-foreground">The City of Sails ⛵</p>
              </div>
            </MarkerPopup>
          </MapMarker>
        </Map>
      </div>

      <div class="article-body" style="max-width: 100%;">
        {Content && <Content />}
      </div>
    </div>
  </section>
</Layout>
