---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import FilterBar from "@/components/FilterBar.astro";
import { getCollection } from "astro:content";

// Get all portfolio items
const projects = await getCollection("portfolio");

// Sort by featured then order
const sortedProjects = projects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  const orderA = a.data.order || 999;
  const orderB = b.data.order || 999;
  return orderA - orderB;
});

const filters = [
  { label: 'Web', value: 'web' },
  { label: 'Tools', value: 'tool' },
  { label: 'Blog / Content', value: 'blog' },
];
---

<Layout title="Portfolio | Harman Singh Hira" schemaType="portfolio">
  <section style="padding-top:clamp(6rem,12vw,9rem);">
    <div class="container">
      <div class="section-header reveal">
        <div class="code-comment">// portfolio.js — things I actually shipped</div>
        <div class="label">Portfolio</div>
        <h2 class="section-title">What I've built</h2>
        <p class="section-subtitle">Projects born from curiosity, necessity, or just because it seemed fun at 2am.</p>
      </div>
      
      <FilterBar filters={filters} targetSelector=".project-card" />
      
      <div class="projects-grid">
        {sortedProjects.map((project) => (
          <ProjectCard 
            name={project.data.title}
            desc={project.data.description}
            tags={project.data.tags}
            icon={project.data.icon}
            image={project.data.image}
            featured={project.data.featured}
            category={project.data.category}
            slug={project.id}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>