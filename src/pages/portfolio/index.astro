---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import FilterBar from "@/components/FilterBar.astro";
import PageHeader from "@/components/PageHeader.astro";
import PageContainer from "@/components/PageContainer.astro";
import InfiniteScroll from "@/components/InfiniteScroll.astro";
import { getCollection } from "astro:content";

// Get all portfolio items
const projects = await getCollection("portfolio");

// Sort by featured then order
const sortedProjects = projects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  const orderA = a.data.order || 999;
  const orderB = b.data.order || 999;
  return orderA - orderB;
});

// Automatically get tags for filters
const allTags = projects.flatMap(p => p.data.tags || []);
const uniqueTags = [...new Set(allTags)].filter(tag => tag !== "project"); // Filter out generic "project" tag if any
const filters = uniqueTags.sort().map(tag => ({
  label: tag,
  value: tag.toLowerCase()
}));
---

<Layout title="Portfolio | Harman Singh Hira" schemaType="portfolio">
  <PageContainer>
    <PageHeader 
      comment="// portfolio.js — things I actually shipped"
      label="Portfolio"
      title="What I've built"
      subtitle="Projects born from curiosity, necessity, or just because it seemed fun at 2am."
    />
    
    <FilterBar filters={filters} targetSelector=".project-card" />
    
    <div class="projects-grid">
      {sortedProjects.map((project) => (
        <ProjectCard 
          name={project.data.title}
          desc={project.data.description}
          tags={project.data.tags}
          icon={project.data.icon}
          image={project.data.image}
          featured={project.data.featured}
          category={project.data.category}
          slug={project.id}
        />
      ))}
    </div>

    <InfiniteScroll targetSelector=".project-card" pageSize={6} />
  </PageContainer>
</Layout>