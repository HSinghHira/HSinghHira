---
import Layout from "@/layouts/Layout.astro";
import PageContainer from "@/components/PageContainer.astro"; 
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import SocialShare from "@/components/SocialShare.astro";

export async function getStaticPaths() {
  const projects = await getCollection("portfolio");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, tags, image, icon, github, demo, pubDatetime, modDatetime, technologies, links} = project.data;
const { Content } = await render(project);
const currentUrl = Astro.url.href;

const formatDate = (date: Date | undefined | null) => {
  if (!date) return "";
  return new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
};
---

<Layout title={`${title} | Portfolio`} schemaType="portfolio">
  <PageContainer>
    <a href="/portfolio" class="project-back">← Back to portfolio</a>
    
    <div class="project-page-hero">
      {image ? (
        <img src={image} alt={title} />
      ) : (
        <div class="project-page-hero-emoji">{icon || '🛠️'}</div>
      )}
    </div>

    <header class="project-header">
      <h1 class="project-page-title">{title}</h1>
      
      {(pubDatetime || modDatetime) && (
        <div class="post-date">
          {pubDatetime && <span>Published: {formatDate(pubDatetime)}</span>}
          {modDatetime && <span class="updated-date">Updated: {formatDate(modDatetime)}</span>}
        </div>
      )}

      <div class="project-page-meta">
        <div class="project-links-row">
          {(github || demo || (links && links.length > 0)) && (
            <div class="project-page-links">
              {demo && <a href={demo} target="_blank" class="btn btn-primary"><Icon name="mdi:open-in-new" />Live Demo</a>}
              {github && <a href={github} target="_blank" class="btn btn-ghost"><Icon name="simple-icons:github" />GitHub</a>}
              {links && links.map((link: any) => (
                <a href={link.url} target="_blank" class="btn btn-ghost">
                  {link.icon && link.icon.includes(':') ? <Icon name={link.icon} /> : link.icon} {link.title}
                </a>
              ))}
            </div>
          )}
        </div>
        
        {((tags && tags.length > 0) || (technologies && technologies.length > 0)) && (
          <div class="project-page-tags">
            {technologies && technologies.map((tech: string) => (
              <span class="project-tag tech-tag">{tech}</span>
            ))}
            {tags && tags.map((tag: string) => (
              <span class="project-tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="project-page-body prose post-content">
      <Content />
    </div>

    <SocialShare title={title} url={currentUrl} />
  </PageContainer>
</Layout>

<style>
  .project-back {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--text-3);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    transition: 0.2s;
  }

  .project-back:hover {
    color: var(--accent);
    transform: translateX(-4px);
  }

  .project-header {
    margin-bottom: 3rem;
  }

  .post-date {
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-3);
    font-family: var(--font-mono);
  }

  .updated-date {
    margin-left: 1rem;
  }

  .project-page-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .project-links-row {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .tech-tag {
    border-color: var(--accent) !important;
    color: var(--accent) !important;
  }

  .project-page-body {
    margin-top: 4rem;
    margin-bottom: 4rem;
  }
</style>

