---
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/PostCard.astro";
import FilterBar from "@/components/FilterBar.astro";
import PageHeader from "@/components/PageHeader.astro";
import PageContainer from "@/components/PageContainer.astro";
import InfiniteScroll from "@/components/InfiniteScroll.astro";
import { getCollection } from "astro:content";

const stories = await getCollection("stories");

const sortedStories = stories.sort((a, b) => {
  const dateA = a.data.pubDatetime || a.data.date || new Date();
  const dateB = b.data.pubDatetime || b.data.date || new Date();
  return dateB.valueOf() - dateA.valueOf();
});

// Automatically get categories for filters
const categories = [...new Set(stories.map(s => s.data.category).filter((cat): cat is string => !!cat))];
const filters = categories.map(cat => ({
  label: cat.charAt(0).toUpperCase() + cat.slice(1),
  value: cat.toLowerCase()
}));
---

<Layout title="Life Stories | Harman Singh Hira" schemaType="posts">
  <PageContainer>
    <PageHeader 
      comment="// life.log — things that actually matter"
      label="Life Stories"
      title="Beyond the code"
      subtitle="Because there's more to life than the terminal. Being an immigrant, a dad, and figuring things out in Aotearoa."
    />

    <FilterBar filters={filters} targetSelector=".post-card" />

    <div class="blog-grid">
      {sortedStories.map((story, i) => (
        <PostCard 
          title={story.data.title}
          excerpt={story.data.excerpt || ""}
          date={story.data.pubDatetime || story.data.date || new Date()}
          readTime={story.data.readTime}
          category={story.data.category}
          featured={story.data.featured}
          slug={story.id}
          index={i + 1}
          basePath="/stories"
          tags={story.data.tags}
        />
      ))}
    </div>

    <InfiniteScroll targetSelector=".post-card" pageSize={3} />
  </PageContainer>
</Layout>

