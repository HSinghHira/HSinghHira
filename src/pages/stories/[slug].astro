---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import PageContainer from "@/components/PageContainer.astro";
import { getCollection, render } from "astro:content";
import SocialShare from "@/components/SocialShare.astro";

export async function getStaticPaths() {
  const stories = await getCollection("stories");
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const { title, excerpt, date, pubDatetime, modDatetime, readTime, category, tags } = story.data;
const { Content } = await render(story);
const currentUrl = Astro.url.href;

const formatDate = (date: Date) => {
  return new Date(date).toLocaleString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
};

const publishDate = pubDatetime || date || new Date();
const formattedDate = formatDate(publishDate);
---

<Layout title={`${title} | Life Stories`} schemaType="post">
  <PageContainer>
    <a href="/stories" class="project-back">← Back to life stories</a>
    
    <header class="story-header">
      <div class="story-meta">
        {category && <span class="story-category">{category}</span>}
        <span class="story-date">{formattedDate}</span>
        {readTime && <span class="story-readtime">• {readTime}</span>}
      </div>
      
      <h1 class="story-title">{title}</h1>
      
      <div class="story-tags">
        {tags && (tags as string[]).map((tag: string) => (
          <span class="story-tag">#{tag}</span>
        ))}
      </div>

      {excerpt && <p class="story-excerpt">{excerpt}</p>}
      {modDatetime && <div class="story-updated">Last updated: {formatDate(modDatetime)}</div>}
    </header>

    <div class="story-content post-content">
      <Content />
    </div>

    <SocialShare title={title} url={currentUrl} />
  </PageContainer>
</Layout>

<style>
  .project-back {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--text-3);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    transition: 0.2s;
  }

  .project-back:hover {
    color: var(--accent);
    transform: translateX(-4px);
  }

  .story-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .story-meta {
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-3);
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .story-category {
    background: var(--accent-dim);
    color: var(--accent);
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
  }

  .story-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .story-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .story-tag {
    font-size: 0.75rem;
    color: var(--text-3);
    background: var(--bg-2);
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  .story-excerpt {
    font-size: 1.2rem;
    color: var(--text-2);
    line-height: 1.6;
    max-width: 800px;
  }

  .story-updated {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--text-3);
    font-style: italic;
  }

  .story-content {
    margin-top: 3rem;
  }
</style>


