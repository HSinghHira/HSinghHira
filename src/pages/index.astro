---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import '../styles/root.css';
// Get all links and sort by order
const links = await getCollection('links');
const sortedLinks = links.sort((a, b) => a.data.order - b.data.order);

// Profile configuration
const profile = {
  name: "Harman Singh Hira",
  bio: "Creator • Developer • Dreamer",
  location: "Based in Aotearoa (New Zealand)",
  avatar: "https://avatars.githubusercontent.com/u/11346694"
};
---

<Layout title="Harman Singh Hira">
  <main class="linktree-container">
    <!-- Animated Background Elements -->
    <div class="background-effects">
      <div class="grid-pattern"></div>
      <div class="mouse-glow" id="mouseGlow"></div>
    </div>

    <!-- Main Content -->
    <div class="content">
      <!-- Profile Section -->
      <div class="profile-section">
        <div class="avatar-container">
          <div class="avatar-glow"></div>
          <img src={profile.avatar} alt="Profile" class="avatar" />
          <div class="status-badge">
            <i class="ri-star-fill" style="font-size: 14px;"></i>
          </div>
        </div>
        <h1 class="profile-name">{profile.name}</h1>
        <p class="profile-bio">{profile.bio}</p>
        <p class="profile-location">{profile.location}</p>
      </div>

      <!-- Action Buttons -->
      <div class="action-buttons">
        <a href="https://me.hsinghhira.me/" target="_blank" rel="noopener noreferrer" class="btn-outline btn" data-title="Personal Blog" data-url="https://me.hsinghhira.me/">
          <i class="ri-link"></i>
          Personal Blog
        </a>
        <a href="https://ultimatetech.org/" target="_blank" rel="noopener noreferrer" class="btn-outline btn" data-title="My Tech Blog" data-url="https://ultimatetech.org/">
          <i class="ri-links-line"></i>
          <span class="btn-text">My Tech Blog</span>
        </a>
      </div>

      <!-- Links Section -->
      <div class="links-container">
        {sortedLinks.map((link, index) => (
          <a 
            href={link.data.link} 
            target="_blank" 
            rel="noopener noreferrer"
            class="link-card"
            style={`animation-delay: ${index * 0.05}s`}
            data-title={link.data.title}
            data-url={link.data.link}
          >
            <div class="link-glow"></div>
            <div class="link-content">
              <div class="link-icon" style={`background: ${link.data.bgColor}`}>
                <i class={link.data.icon} style="font-size: 20px;"></i>
              </div>
              <span class="link-title">{link.data.title}</span>
              <i class="ri-arrow-right-s-line link-arrow" style="font-size: 20px;"></i>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>

<script>
  // Mouse follow glow effect
  const mouseGlow = document.getElementById('mouseGlow') as HTMLElement | null;
  let mouseX = 0, mouseY = 0;
  let glowX = 0, glowY = 0;

  if (mouseGlow) {
    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      mouseGlow.style.opacity = '1';
    });

    document.addEventListener('mouseleave', () => {
      mouseGlow.style.opacity = '0';
    });

    function animateGlow() {
      glowX += (mouseX - glowX) * 0.1;
      glowY += (mouseY - glowY) * 0.1;
      mouseGlow!.style.left = glowX + 'px';
      mouseGlow!.style.top = glowY + 'px';
      requestAnimationFrame(animateGlow);
    }
    animateGlow();
  }

  // Analytics Event Tracking
  declare var gtag: Function;

  // Track Link Card Clicks
  const linkCards = document.querySelectorAll('.link-card');
  linkCards.forEach(card => {
    card.addEventListener('click', () => {
      const title = card.getAttribute('data-title');
      const url = card.getAttribute('data-url');
      if (typeof gtag === 'function') {
        gtag('event', 'select_content', {
          content_type: 'link_card',
          item_id: title,
          link_url: url
        });
      }
    });
  });

  // Track Button Clicks
  const shareBtn = document.getElementById('shareBtn');
  const copyBtn = document.getElementById('copyBtn');

  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      if (typeof gtag === 'function') {
        gtag('event', 'share', {
          method: 'personal_blog_click',
          content_type: 'button'
        });
      }
    });
  }

  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      if (typeof gtag === 'function') {
        gtag('event', 'select_content', {
          content_type: 'button',
          item_id: 'tech_blog_click'
        });
      }
    });
  }
</script>