---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="404 — Page Not Found | Harman Singh Hira">
  <main class="page-404">
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>
    <div class="hero-glow2"></div>

    <!-- Big ghost numerals with a floating badge -->
    <div class="err-code-wrap">
      <div class="err-big" aria-hidden="true">4<span class="accent-digit">0</span>4</div>
      <div class="err-code-badge">
        <span class="dc-kw">throw</span>
        <span class="dc-kw">new</span>&nbsp;<span class="dc-fn">NotFoundError</span><span class="dc-br">(</span><span class="dc-num">404</span><span class="dc-br">)</span>
      </div>
    </div>

    <!-- Copy -->
    <div class="err-inner">
      <div class="label">error_boundary.tsx</div>
      <h1 class="err-title">This page doesn't exist&nbsp;— yet.</h1>
      <p class="err-desc">
        Looks like you've wandered into uncharted territory. The URL you followed
        either moved, got deleted, or never made it out of draft.
      </p>
      <div class="err-actions">
        <a href="/" class="btn btn-primary">
          <Icon name="mdi:home" style="width: 1.1rem; height: 1.1rem;" />
          Back to Home
        </a>
        <a href="/contact" class="btn btn-ghost">Report this</a>
      </div>
    </div>

    <!-- Terminal card -->
    <div class="err-terminal">
      <div class="term-bar">
        <span class="term-dot term-dot-r"></span>
        <span class="term-dot term-dot-y"></span>
        <span class="term-dot term-dot-g"></span>
        <span class="term-label">~/harman — zsh</span>
      </div>
      <div>
        <span class="dc-cmt">// resolving route...</span>
      </div>
      <div>
        <span class="dc-kw">const</span> <span class="dc-key">page</span> <span class="dc-br">= await</span> <span class="dc-fn">router</span><span class="dc-br">.</span><span class="dc-fn">resolve</span><span class="dc-br">(</span><span class="dc-str">"<span id="bad-path">/???</span>"</span><span class="dc-br">)</span>
      </div>
      <div>
        <span class="dc-cmt">// returned</span> <span class="dc-num">null</span>
      </div>
      <div>&nbsp;</div>
      <div>
        <span class="dc-key">❯</span> <span class="dc-fn">redirect</span><span class="dc-br">(</span><span class="dc-str">"/"</span><span class="dc-br">)</span><span class="cursor"></span>
      </div>
    </div>

    <!-- Quick nav suggestions -->
    <div class="err-suggestions">
      <span class="suggestion-pill-label" style="width:100%">// maybe you were looking for</span>
      <a class="suggestion-pill" href="/">
        <Icon name="mdi:home" style="width: 11px; height: 11px;" />
        home
      </a>
      <a class="suggestion-pill" href="/portfolio">
        <Icon name="mdi:briefcase" style="width: 11px; height: 11px;" />
        portfolio
      </a>
      <a class="suggestion-pill" href="/posts">
        <Icon name="mdi:file-document-outline" style="width: 11px; height: 11px;" />
        blog
      </a>
      <a class="suggestion-pill" href="/stories">
        <Icon name="mdi:pencil-outline" style="width: 11px; height: 11px;" />
        life stories
      </a>
      <a class="suggestion-pill" href="/contact">
        <Icon name="mdi:email-outline" style="width: 11px; height: 11px;" />
        contact
      </a>
    </div>
  </main>
</Layout>

<style is:global>
  /* 404 LAYOUT */
  .page-404 {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 0 clamp(1.5rem,5vw,4rem);
    position: relative;
    overflow: hidden;
    text-align: center;
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .hero-grid {
    position: absolute; inset: 0; opacity: 0.022;
    background-image: linear-gradient(rgba(200,169,122,0.6) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(200,169,122,0.6) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
  }
  [data-theme="light"] .hero-grid { opacity: 0.055; }

  .hero-glow {
    position: absolute; width: 700px; height: 700px; border-radius: 50%;
    background: radial-gradient(circle, var(--accent-dim) 0%, transparent 70%);
    top: -180px; left: 50%; transform: translateX(-50%);
    pointer-events: none;
  }
  .hero-glow2 {
    position: absolute; width: 400px; height: 400px; border-radius: 50%;
    background: radial-gradient(circle, var(--blue-dim) 0%, transparent 70%);
    bottom: -80px; right: -100px;
    pointer-events: none;
  }

  .err-code-wrap {
    position: relative; z-index: 1;
    margin-bottom: 2rem;
    animation: fadeUp 0.7s ease 0.05s both;
  }

  .err-big {
    font-family: 'Syne', sans-serif;
    font-size: clamp(7rem, 22vw, 16rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--border-hover);
    position: relative;
    user-select: none;
  }

  .err-big .accent-digit {
    color: var(--accent);
    -webkit-text-stroke: 0;
    opacity: 0.18;
  }

  .err-code-badge {
    position: absolute;
    top: 50%; left: 50%; transform: translate(-50%, -50%);
    background: var(--bg-3);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.6rem 1.25rem;
    display: flex; align-items: center; gap: 0.6rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    color: var(--text-3);
    white-space: nowrap;
  }

  .err-inner {
    position: relative; z-index: 1;
    max-width: 540px;
    animation: fadeUp 0.7s ease 0.2s both;
  }

  .err-inner .label { justify-content: center; margin-bottom: 1rem; }
  .err-inner .label::before { display: none; }

  .err-title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .err-desc {
    color: var(--text-2);
    font-size: 1rem;
    font-weight: 300;
    margin-bottom: 2.5rem;
    line-height: 1.75;
  }

  .err-actions {
    display: flex; flex-wrap: wrap; gap: 0.75rem;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .err-terminal {
    position: relative; z-index: 1;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    line-height: 2;
    text-align: left;
    max-width: 420px;
    width: 100%;
    animation: fadeUp 0.7s ease 0.35s both;
    margin-bottom: 2rem;
  }
  .err-terminal:hover { border-color: var(--border-hover); }

  .term-bar {
    display: flex; align-items: center; gap: 0.45rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .term-dot {
    width: 9px; height: 9px; border-radius: 50%;
  }
  .term-dot-r { background: #e07b6a; }
  .term-dot-y { background: var(--accent); opacity: 0.7; }
  .term-dot-g { background: var(--green, #4dbd74); opacity: 0.7; }
  .term-label { color: var(--text-3); font-size: 0.68rem; margin-left: auto; letter-spacing: 0.05em; }

  .dc-kw  { color: var(--blue, #6b9fff); }
  .dc-fn  { color: var(--accent); }
  .dc-str { color: var(--green, #4dbd74); }
  .dc-num { color: #e07b6a; }
  .dc-cmt { color: var(--text-3); opacity: 0.6; }
  .dc-br  { color: var(--text-2); }
  .dc-key { color: var(--text); }

  .cursor {
    display: inline-block;
    width: 8px; height: 1em;
    background: var(--accent);
    opacity: 0.8;
    vertical-align: text-bottom;
    animation: blink 1.1s step-end infinite;
    border-radius: 1px;
  }
  @keyframes blink { 0%,100%{opacity:0.8} 50%{opacity:0} }

  .err-suggestions {
    position: relative; z-index: 1;
    margin-top: 1rem;
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    justify-content: center;
    animation: fadeUp 0.7s ease 0.45s both;
  }

  .suggestion-pill {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: var(--bg-3); border: 1px solid var(--border);
    border-radius: 99px;
    padding: 0.3rem 0.9rem;
    font-size: 0.78rem; color: var(--text-2);
    font-family: 'JetBrains Mono', monospace;
    text-decoration: none;
    transition: 0.25s; cursor: pointer;
  }
  .suggestion-pill:hover {
    border-color: var(--border-hover);
    color: var(--text);
    background: var(--bg-4);
  }
  .suggestion-pill-label {
    font-size: 0.6rem; color: var(--text-3);
    margin-bottom: 0.5rem;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: block;
    text-align: center;
  }

  @keyframes fadeUp { from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none} }
</style>

<script is:inline>
  function updateBadPath() {
    const badPath = document.getElementById('bad-path');
    if (badPath) badPath.textContent = window.location.pathname || '/???';
  }
  
  updateBadPath();
  document.addEventListener('astro:page-load', updateBadPath);
</script>