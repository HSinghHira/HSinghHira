---
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <main
    id="main-content"
    class="flex flex-1 justify-center items-center mx-auto max-w-3xl min-h-[60vh]"
  >
    <div class="flex flex-col justify-center items-center">
      <h1 class="font-bold text-(--color-primary) text-9xl">404</h1>
      <span aria-hidden="true" class="text-4xl">¯\_(ツ)_/¯</span>
      <p class="mt-4 text-2xl sm:text-3xl">Page Not Found</p>
      <a
        href="/"
        class="my-6 underline decoration-dashed underline-offset-8 hover:text-(--color-primary) text-lg"
      >
        Go back home
      </a>
    </div>
  </main>
</Layout>