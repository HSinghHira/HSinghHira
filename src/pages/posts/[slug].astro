---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import PageContainer from "@/components/PageContainer.astro";
import { getCollection, render } from "astro:content";
import SocialShare from "@/components/SocialShare.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, pubDatetime, modDatetime, readTime, category, tags } = post.data;
const { Content, headings } = await render(post);
const currentUrl = Astro.url.href;

// Filter headings for TOC (H2 and H3)
const toc = headings.filter(h => h.depth <= 3);

const formatDate = (date: Date) => {
  return new Date(date).toLocaleString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
};
---

<Layout title={`${title} | Blog`} schemaType="post">
  <PageContainer>
    <a href="/posts" class="project-back">← Back to blog</a>
    
    <header class="post-header-wrap">
      <div class="post-meta">
        {category && <span class="post-category">{category}</span>}
        {tags && (tags as string[]).map((tag: string) => (
          <span class="post-tag">#{tag}</span>
        ))}
      </div>
      
      <h1 class="post-hero-title">{title}</h1>

      {description && <p class="post-hero-description">{description}</p>}
      
      {(pubDatetime || modDatetime) && (
        <div class="post-date-row">
          {readTime && <span class="meta-item">Read Time: {readTime}</span>}
          {pubDatetime && <span class="meta-item">Published: {formatDate(pubDatetime)}</span>}
          {modDatetime && <span class="meta-item">Updated: {formatDate(modDatetime)}</span>}
        </div>
      )}
    </header>
    
    {toc.length > 0 && (
      <div class="post-toc reveal">
        <h2 class="toc-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          Table of Contents
        </h2>
        <ul>
          {toc.map(heading => (
            <li style={`padding-left: ${ (heading.depth - 2) * 1.5 }rem;`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="post-content">
      <Content />
    </div>

    <SocialShare title={title} url={currentUrl} />
  </PageContainer>
</Layout>

<style>
  .post-header-wrap {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2rem;
  }

  .post-meta {
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .post-category {
    background: var(--accent-dim);
    color: var(--accent);
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
  }

  .post-tag {
    font-size: 0.75rem;
    color: var(--text-3);
    background: var(--bg-2);
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  .post-date-row {
    margin-top: 1.5rem;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .meta-item {
    color: var(--text-3);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }

  .post-toc {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .toc-title {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .post-toc ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .post-toc a {
    font-size: 0.9rem;
    color: var(--text-2);
    text-decoration: none;
    transition: 0.2s;
  }

  .post-toc a:hover {
    color: var(--accent);
  }

  .project-back {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--text-3);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    transition: 0.2s;
  }

  .project-back:hover {
    color: var(--accent);
    transform: translateX(-4px);
  }
</style>


