---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import SocialShare from "@/components/SocialShare.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, pubDatetime, modDatetime, readTime, category, tags } = post.data;
const { Content, headings } = await render(post);
const currentUrl = Astro.url.href;

// Filter headings for TOC (H2 and H3)
const toc = headings.filter(h => h.depth <= 3);

const formatDate = (date: Date) => {
  return new Date(date).toLocaleString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
};
---

<Layout title={`${title} | Blog`} schemaType="post">
  <article class="post-article" style="padding-top:clamp(6rem,12vw,9rem); padding-bottom:5rem;">
    <div class="container" style="max-width:800px; margin: 0 auto;">
      <a href="/posts" class="project-back">← Back to blog</a>
      <div class="post-header" style="margin-bottom:1rem; border-bottom:1px solid var(--border); padding-bottom:2rem;">
        <div class="post-meta" style="margin-bottom:1.5rem; font-family:var(--font-mono); font-size:0.875rem; color:var(--text-muted); display:flex; gap:1rem; flex-wrap:wrap; align-items:center;">
          {category && <span class="post-category" style="background:var(--accent-dim); color:var(--accent); padding:0.2rem 0.6rem; border-radius:100px;">{category}</span>}
          {tags && (tags as string[]).map((tag: string) => (
            <span style="font-size:0.75rem; color:var(--text-3); background:var(--bg-2); padding:0.1rem 0.5rem; border-radius:4px; border:1px solid var(--border);">#{tag}</span>
          ))}
        </div>
        
        <h1 style="font-family:var(--font-display); font-size:clamp(2rem,4vw,3.5rem); font-weight:800; line-height:1.1; letter-spacing:-0.03em; margin-bottom:1.5rem;">{title}</h1>

        {description && <p style="font-size:1.2rem; color:var(--text-2); line-height:1.6;">{description}</p>}
        {(pubDatetime || modDatetime) && (
          <div class="post-date" style="margin-top: 1.5rem; display:flex; gap:1rem; flex-wrap:wrap; align-items:center;">
            {readTime && <span style="color: var(--text-3);">Read Time: {readTime}</span>}
            {pubDatetime && <span style="color: var(--text-3);">Published: {formatDate(pubDatetime)}</span>}
            {modDatetime && <span style="margin-left: 1rem; color: var(--text-3);">Updated: {formatDate(modDatetime)}</span>}
            
          </div>
        )}
      </div>
      
      {toc.length > 0 && (
        <div class="post-toc reveal" style="background:var(--bg-2); border:1px solid var(--border); border-radius:12px; padding:1.5rem; margin-bottom:3rem;">
          <h2 style="font-size:0.9rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:var(--accent); margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
            Table of Contents
          </h2>
          <ul style="list-style:none; padding:0; display:flex; flex-direction:column; gap:0.5rem;">
            {toc.map(heading => (
              <li style={`padding-left: ${ (heading.depth - 2) * 1.5 }rem;`}>
                <a href={`#${heading.slug}`} style="font-size:0.9rem; color:var(--text-2); text-decoration:none; transition:0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-2)'">
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="post-content" style="font-size:1.125rem; line-height:1.8; color:var(--text); font-family:var(--font-sans);">
        <Content />
      </div>

      <SocialShare title={title} url={currentUrl} />
    </div>
  </article>
</Layout>

<style is:global>
.post-content h2 {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 700;
  margin-top: 3rem;
  margin-bottom: 1.5rem;
  letter-spacing: -0.02em;
}
.post-content h3 {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 600;
  margin-top: 2.5rem;
  margin-bottom: 1rem;
}
.post-content p {
  margin-bottom: 1.5rem;
}
.post-content ul, .post-content ol {
  margin-bottom: 1.5rem;
  padding-left: 1.5rem;
}
.post-content li {
  margin-bottom: 0.5rem;
}
.post-content img {
  max-width: 100%;
  border-radius: 8px;
  border: 1px solid var(--border);
  margin: 2rem 0;
}
.post-content blockquote {
  border-left: 3px solid var(--primary);
  padding-left: 1.5rem;
  margin: 2rem 0;
  font-style: italic;
  color: var(--text-2);
}
.post-content code:not(pre code) {
  font-family: var(--font-mono);
  font-size: 0.9em;
  background: var(--bg-2);
  padding: 0.2em 0.4em;
  border-radius: 4px;
}
.post-content pre {
  padding: 1.5rem;
  border-radius: 8px;
  border: 1px solid var(--border);
  margin: 2rem 0;
  overflow-x: auto;
}
</style>
