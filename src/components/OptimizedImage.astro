---
// src/components/OptimizedImage.astro
export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: "lazy" | "eager";
  quality?: number;
  crop?: "center" | "top" | "bottom" | "left" | "right" | "entropy" | "attention";
}

import { SITE } from "@/config";

const {
  src,
  alt,
  width,
  height,
  class: className,
  loading = "lazy",
  quality = 80,
  crop = "center", // ← new option
} = Astro.props;

const absoluteSrc = src.startsWith("http")
  ? src
  : new URL(src, SITE.website).href;

// weserv.nl parameters
const params = new URLSearchParams({
  url: absoluteSrc,
  q: String(quality),
  af: "",        // auto-format (WebP/AVIF)
  il: "",        // progressive
  "n": "-1",     // strip metadata
  l: "9",        // compression level
  output: "webp",
});

if (width) params.set("w", String(width));
if (height) params.set("h", String(height));
if (width && height) {
  params.set("fit", "cover");
  params.set("crop", crop); // ← forces center crop (or entropy, attention, etc.)
}

const weservUrl = `https://images.weserv.nl/?${params.toString()}`;
---

<img
  src={weservUrl}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  class={className}
  style={width && height ? `aspect-ratio: ${width}/${height}` : undefined}
/>