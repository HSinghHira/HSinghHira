---
// src/components/OptimizedImage.astro
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  src: string | ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: "lazy" | "eager";
  quality?: number | string;
  crop?: "center" | "top" | "bottom" | "left" | "right" | "entropy" | "attention";
}

const {
  src,
  alt,
  width,
  height,
  class: className,
  loading = "lazy",
  quality = 80,
} = Astro.props;
---

<Image
  src={src as any}
  alt={alt}
  width={width as any}
  height={height as any}
  inferSize={(!width || !height) ? true : undefined}
  loading={loading}
  decoding="async"
  class={className}
  quality={quality}
  style={width && height ? `aspect-ratio: ${width}/${height}` : undefined}
/>