---
// src/components/Nav.astro
import { Icon } from "astro-icon/components";

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isPortfolio = pathname.startsWith('/portfolio');
const isBlog = pathname.startsWith('/blog') || pathname.startsWith('/posts');
const isStories = pathname.startsWith('/stories');
const isContact = pathname.startsWith('/contact');
---

<nav>
  <a href="/" class="nav-logo">H<span>.</span></a>
  <ul class="nav-links">
    <li><a href="/" class={isHome ? 'active' : ''}>Home</a></li>
    <li><a href="/portfolio" class={isPortfolio ? 'active' : ''}>Portfolio</a></li>
    <li><a href="/posts" class={isBlog ? 'active' : ''}>Blog</a></li>
    <li><a href="/stories" class={isStories ? 'active' : ''}>Life Stories</a></li>
    <li><a href="/contact" class={`nav-cta ${isContact ? 'active' : ''}`}>Contact</a></li>
  </ul>
  <div class="nav-right">
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
      <Icon name="mdi:weather-night" class="icon-moon" />
      <Icon name="mdi:weather-sunny" class="icon-sun" />
    </button>
    <button class="hamburger" id="hamburger" aria-label="Menu"><span></span><span></span><span></span></button>
  </div>
</nav>

<div class="mobile-menu" id="mobile-menu">
  <a href="/">Home</a>
  <a href="/portfolio">Portfolio</a>
  <a href="/posts">Blog</a>
  <a href="/stories">Life Stories</a>
  <a href="/contact">Contact</a>
  <div class="mobile-menu-sep">
    <a href="#" id="mobile-theme-label">☀️ Switch to Light Mode</a>
  </div>
</div>

<script is:inline>
  function toggleTheme() {
    const html = document.documentElement;
    const current = html.getAttribute('data-theme') || 'dark';
    const next = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    updateThemeLabel();
  }

  function updateThemeLabel() {
    const html = document.documentElement;
    const current = html.getAttribute('data-theme') || 'dark';
    const label = document.getElementById('mobile-theme-label');
    if (label) {
      label.innerText = current === 'dark' ? '☀️ Switch to Light Mode' : '🌙 Switch to Dark Mode';
    }
  }

  function toggleMobile() {
    const menu = document.getElementById('mobile-menu');
    menu.classList.toggle('open');
  }

  function setupNav() {
    const themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', toggleTheme);
    }
    
    const hamburger = document.getElementById('hamburger');
    if (hamburger) {
      hamburger.addEventListener('click', toggleMobile);
    }
    
    const mobileThemeLabel = document.getElementById('mobile-theme-label');
    if (mobileThemeLabel) {
      mobileThemeLabel.addEventListener('click', (e) => {
        e.preventDefault();
        toggleTheme();
      });
    }

    updateThemeLabel();
  }

  // Setup on initial load and after Astro page transitions (if using ViewTransitions)
  setupNav();
  document.addEventListener('astro:page-load', setupNav);
</script>
