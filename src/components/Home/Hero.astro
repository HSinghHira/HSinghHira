---
---
<section class="hero" id="home">
  <div class="hero-grid"></div>
  <div class="hero-glow"></div>
  <div class="hero-glow2"></div>
  <div class="hero-inner">
    <div class="hero-status reveal">
      <span class="status-dot"></span>
      Based in Aotearoa (New Zealand)
    </div>
    <h1 class="reveal-delay-1 hero-name reveal">
      Harman<br /><span class="accent">Singh Hira</span>
    </h1>
    <p class="reveal-delay-2 hero-tagline reveal">
      Creator, Tech Enthusiast, and Father.<br />Building things that may
      matter — one weird idea at a time.
    </p>
    <div class="reveal-delay-3 hero-actions reveal">
      <a class="btn btn-primary" href="/portfolio"
        >See my Work <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M2 7h10M8 3l4 4-4 4"></path></svg
        ></a
      >
      <a class="btn btn-ghost" href="/posts">Read Blog</a>
      <a class="btn btn-ghost" href="/contact">Say Kia Ora!</a>
    </div>
  </div>
  <div
    class="reveal-delay-3 hero-scroll reveal"
    onclick="document.getElementById('home-about').scrollIntoView({behavior:'smooth'})"
  >
    <span>scroll</span><div class="scroll-line"></div>
  </div>
</section>

<style>
  /* HERO section specific styles if any, or keep them in global.css */
</style>
