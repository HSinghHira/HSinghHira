---
// src/components/PostCard.astro
import { Icon } from "astro-icon/components";
export interface Props {
  title: string;
  excerpt: string;
  date: Date | string;
  readTime?: string;
  category?: string;
  slug: string;
  featured?: boolean;
  index: number;
  basePath?: string;
  tags?: string[];
}

const { title, excerpt, date, readTime, category, slug, featured, index, basePath = '/posts', tags = [] } = Astro.props;

// Format date nicely
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
});

// Pad number to 2 digits
const displayNum = String(index).padStart(2, '0');

// Category to CSS class
const catClassMap: Record<string, string> = {
  tech: 'cat-tech',
  life: 'cat-life',
  build: 'cat-build',
  story: 'cat-story',
  nz: 'cat-story', // map 'nz', 'family', 'immigrant' to story pill styles if needed
  family: 'cat-life',
  immigrant: 'cat-build'
};
const catClass = catClassMap[category?.toLowerCase() || ''] || 'cat-tech';
---

<a href={`${basePath}/${slug}`} class={`post-card ${featured ? 'featured' : ''}`} data-category={category?.toLowerCase() || 'tech'}>
  <div class="post-card-inner">
    <div class="post-card-num">{displayNum}</div>
    <div class="post-card-text">
      <div class="post-meta">
        {category && <span class={`post-category ${catClass}`}>{category}</span>}
        <span class="post-date">{formattedDate}</span>
        {readTime && <span class="post-read"><Icon name="mdi:clock-outline" style="width: 0.9rem; height: 0.9rem; display: inline; vertical-align: middle; margin-right: 0.2rem; opacity: 0.6;" />{readTime}</span>}
      </div>
      {featured && <div class="post-featured-flag">★ Featured</div>}
      <h3 class="post-title">{title}</h3>
      {tags.length > 0 && (
        <div class="post-tags" style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:0.75rem; margin-top:-0.5rem;">
          {tags.map(tag => (
            <span style="font-size:0.7rem; color:var(--text-3); font-family:var(--font-mono); opacity:0.8;">#{tag}</span>
          ))}
        </div>
      )}
      <p class="post-excerpt">{excerpt}</p>
    </div>
  </div>
</a>
