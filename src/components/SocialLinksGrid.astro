---

<div class="links-container">
  {links.map((link) => (
    <a 
      href={link.url} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="link-card" 
      style={`animation-delay: ${link.delay}`}
      data-title={link.title}
    >
      <div class="link-glow"></div>
      <div class="link-content">
        <div class="link-icon" style={`background: ${link.color}`}>
          <Fragment set:html={link.icon} />
        </div>
        <span class="link-title">{link.title}</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="link-arrow">
          <path d="M13.172 12l-4.95-4.95 1.414-1.414L16 12l-6.364 6.364-1.414-1.414z"></path>
        </svg>
      </div>
    </a>
  ))}
</div>

<style>
  .links-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.75rem;
    width: 100%;
  }

  .link-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.75rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    animation: fadeUp 0.5s ease both;
  }

  .link-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    background: var(--bg-3);
    box-shadow: 0 10px 20px -10px rgba(0, 0, 0, 0.3);
  }

  .link-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, var(--accent-dim) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .link-card:hover .link-glow {
    opacity: 0.5;
  }

  .link-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .link-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .link-card:hover .link-icon {
    transform: scale(1.1);
  }

  .link-icon :global(svg) {
    width: 18px;
    height: 18px;
  }

  .link-title {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .link-arrow {
    margin-left: auto;
    width: 16px;
    height: 16px;
    color: var(--text-3);
    transition: all 0.3s ease;
    opacity: 0;
    transform: translateX(-5px);
  }

  .link-card:hover .link-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--accent);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Support for light theme contrast */
  [data-theme="light"] .link-icon {
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
</style>
