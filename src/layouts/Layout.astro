---
interface Props {
	title: string;
}

const { title } = Astro.props;
import 'remixicon/fonts/remixicon.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="My Social Links" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="MySocial" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-D588K4KJ64"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-D588K4KJ64');
		</script>
		<title>{title}</title>
		<style is:global>
			/* ==========================================================================
			CSS CUSTOM PROPERTIES (GLOBAL VARIABLES)
			========================================================================== */
			:root {
				--bg-color: #222226;
				--text-color: #E6E6E6;
				--input-bg: #333337;
				--valid-color: #44ff44;
				--invalid-color: #ff4444;
				--focus-color: #66aaff;
				--hover-bg: #CCCCCC;
				--disabled-bg: #666;
				--disabled-text: #999;
				--link-highlight: #0fa0ce;
				--warning-color: #ffaa44;
				--border-color: #E6E6E6;
				--hr-color: #e1e1e1;
				--required-color: #ff6666;
			}

			/* ==========================================================================
			FONT DEFINITIONS
			========================================================================== */
			@font-face {
				font-family: Iosevka;
				font-style: normal;
				font-display: block;
				src: url(https://cdn.jsdelivr.net/fontsource/fonts/iosevka@latest/latin-400-normal.woff2) format('woff2'),
					url(https://cdn.jsdelivr.net/fontsource/fonts/iosevka@latest/latin-400-normal.woff) format('woff'),
					url(https://cdn.jsdelivr.net/fontsource/fonts/iosevka@latest/latin-400-normal.ttf) format('truetype');
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			html {
				font-family: Iosevka, monospace;
				background: var(--bg-color);
				color: var(--text-color);
			}

			body {
				min-height: 100vh;
				overflow-x: hidden;
			}

			/* Scrollbar Styling */
			::-webkit-scrollbar {
				width: 8px;
			}

			::-webkit-scrollbar-track {
				background: var(--bg-color);
			}

			::-webkit-scrollbar-thumb {
				background: var(--input-bg);
				border-radius: 4px;
			}

			::-webkit-scrollbar-thumb:hover {
				background: var(--border-color);
			}
		</style>
	</head>
	<body>
		<slot />
	</body>
</html>
